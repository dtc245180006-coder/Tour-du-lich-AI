arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1"><mxGeometry x="880" y="120" width="320" height="60" as="geometry" /></mxCell><mxCell id="a4_d_approve" parent="1" value="Tư vấn viên liên hệ: Khách xác nhận đi hay Hủy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;" vertex="1"><mxGeometry x="620" y="220" width="240" height="70" as="geometry" /></mxCell><mxCell id="a4_cancel" parent="1" value="Bấm 'Từ chối' -&gt; status = 'CANCELLED' (Nhập lý do)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;fillColor=#fee2e2;strokeColor=#ef4444;" vertex="1"><mxGeometry x="250" y="230" width="300" height="50" as="geometry" /></mxCell><mxCell id="a4_confirm" parent="1" value="Bấm 'Xác Nhận Giữ Chỗ' (Kèm Idempotency-Key chống gửi lặp)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;" vertex="1"><mxGeometry x="575" y="330" width="330" height="50" as="geometry" /></mxCell><mxCell id="a4_lock" parent="1" value="Backend mở Transaction &amp; Khóa bản ghi (SELECT ... FOR UPDATE)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;" vertex="1"><mxGeometry x="570" y="415" width="340" height="50" as="geometry" /></mxCell><mxCell id="a4_d_slots" parent="1" value="Số chỗ khả dụng (available_slots) &gt;= Số khách đặt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;" vertex="1"><mxGeometry x="605" y="500" width="270" height="70" as="geometry" /></mxCell><mxCell id="a4_err_slot" parent="1" value="Không đủ chỗ -&gt; Rollback Transaction -&gt; Báo lỗi 'Hết chỗ'" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;fillColor=#fee2e2;strokeColor=#ef4444;" vertex="1"><mxGeometry x="1000" y="510" width="320" height="50" as="geometry" /></mxCell><mxCell id="a4_deduct" parent="1" value="Trừ số chỗ: available_slots -= num_people&lt;br/&gt;Nếu available_slots == 0 -&gt; Đổi status đợt sang 'FULL'" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;" vertex="1"><mxGeometry x="580" y="610" width="320" height="55" as="geometry" /></mxCell><mxCell id="a4_update_bk" parent="1" value="Cập nhật Booking: status = 'PENDING', sinh mã BK-...&lt;br/&gt;Lưu Idempotency Key vào booking_request_keys" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;" vertex="1"><mxGeometry x="580" y="700" width="320" height="55" as="geometry" /></mxCell><mxCell id="a4_commit" parent="1" value="Commit Transaction -&gt; Đồng bộ số liệu sang phân hệ Kế toán" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;" vertex="1"><mxGeometry x="590" y="790" width="300" height="50" as="geometry" /></mxCell><mxCell id="a4_done" parent="1" value="Xuất thông báo 'Giữ chỗ thành công!' (Trạng thái: Chờ thanh toán)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1"><mxGeometry x="580" y="875" width="320" height="50" as="geometry" /></mxCell><mxCell id="a4_end" parent="1" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#ef4444;strokeWidth=2;" vertex="1"><mxGeometry x="725" y="960" width="30" height="30" as="geometry" /></mxCell><mx