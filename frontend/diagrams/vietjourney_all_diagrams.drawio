ể trống" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;" vertex="1"><mxGeometry x="570" y="370" width="310" height="50" as="geometry" /></mxCell><mxCell id="a7_save" parent="1" value="Lưu thông tin vào bảng tour_guides trong CSDL" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;" vertex="1"><mxGeometry x="570" y="450" width="310" height="50" as="geometry" /></mxCell><mxCell id="a7_state" parent="1" value="Theo dõi trạng thái công tác: AVAILABLE (Rảnh) / ON_TOUR (Đang dẫn tour) / OFF (Nghỉ)&lt;br/&gt;Khi một đợt khởi hành chuyển RUNNING -&gt; HDV tự động chuyển ON_TOUR&lt;br/&gt;Khi đợt khởi hành chuyển COMPLETED -&gt; HDV tự động chuyển về AVAILABLE" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;fillColor=#fef3c7;strokeColor=#d97706;" vertex="1"><mxGeometry x="460" y="530" width="530" height="65" as="geometry" /></mxCell><mxCell id="a7_d_del" parent="1" value="Thao tác Xóa: HDV đang được phân công vào đợt khởi hành sắp tới?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;" vertex="1"><mxGeometry x="585" y="630" width="280" height="70" as="geometry" /></mxCell><mxCell id="a7_err_del" parent="1" value="Chặn xóa &amp; Báo lỗi: 'Không thể xóa HDV đang có lịch dẫn tour'" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;fillColor=#fee2e2;strokeColor=#ef4444;" vertex="1"><mxGeometry x="180" y="640" width="330" height="50" as="geometry" /></mxCell><mxCell id="a7_ok_del" parent="1" value="Cho phép xóa hoặc chuyển trạng thái sang OFF" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;s